{
  "name": "dap-bellwether",
  "version": "1.0.0",
  "description": "A regulatory change feed for Canada, the US, the UK and the EU, delivered as an MCP connector. Free for people, agents pay per call.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --import ./test/register-ts.mjs --test test/*.test.mjs",
    "verify:sources": "node scripts/verify-sources.mjs",
    "build:favicon": "node scripts/build-favicon-ico.mjs",
    "build:og": "node scripts/build-og-card.mjs",
    "build:assets": "node scripts/build-assets.mjs",
    "dev": "wrangler dev",
    "db:create": "wrangler d1 create bellwether",
    "db:migrate": "wrangler d1 execute bellwether --file=./schema.sql --remote",
    "db:migrate:local": "wrangler d1 execute bellwether --file=./schema.sql --local",
    "db:migrate:licences": "wrangler d1 execute dap-licences --file=./licences.sql --remote",
    "db:migrate:licences:local": "wrangler d1 execute dap-licences --file=./licences.sql --local",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "wrangler": "^4.0.0"
  }
}
