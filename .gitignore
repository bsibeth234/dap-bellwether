node_modules/

# Wrangler local state, including the local D1 sqlite files.
.wrangler/

# Secrets never enter the repo. Cloudflare credentials live in the environment
# or in wrangler secrets, not here.
.dev.vars
.env
.env.*

# The MCP Registry signing key lives in ~/.config/mcp-publisher/, not here.
# This is a net in case anyone follows the registry docs literally and
# generates key.pem into the working tree.
*.pem
key.pem

*.log
.DS_Store
